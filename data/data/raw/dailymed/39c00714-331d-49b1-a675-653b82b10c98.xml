            <section ID="LINK_8d7c006b-d556-4566-9b16-c7e481b230eb">
               <id root="96454f8e-508e-42a7-b122-d79351ab3c07"/>
               <code code="42229-5" codeSystem="2.16.840.1.113883.6.1" displayName="SPL UNCLASSIFIED SECTION"/>
               <title>Caution<br/>
               </title>
               <text>
                  <paragraph>Federal law restricts this drug to use by or on the order of a licensed veterinarian.</paragraph>
               </text>
               <effectiveTime value="20261006"/>
            </section>
