                           <th styleCode="Lrule Rrule">Adverse Reaction</th>
                           <th styleCode="Rrule">Mometamax Single<br/>(N=245)</th>
                           <th styleCode="Rrule">Control<br/>(N=127)</th>
                        </tr>
                     </thead>
