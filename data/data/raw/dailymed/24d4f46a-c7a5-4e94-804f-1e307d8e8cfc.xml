            <section ID="id_link_a8ecc9f9-cd92-1a06-e053-2995a90a3972">
               <id root="bde3da99-3f86-455b-99a2-a4d3890bf7a6"/>
               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>Active Ingredient (in each tablet)</title>
               <text>
                  <paragraph>Aspirin 81 mg (NSAID) nonsteroidal anti-inflammatory drug</paragraph>
                  <paragraph/>
               </text>
               <effectiveTime value="20261028"/>
            </section>
