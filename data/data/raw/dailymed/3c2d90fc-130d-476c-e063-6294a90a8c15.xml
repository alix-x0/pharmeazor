               <component>
                  <section ID="id_link_81f6d245-f5bc-28b4-e053-2a91aa0a3c04">
                     <id root="3c2f517f-9951-66c8-e063-6294a90aebcb"/>
                     <code code="55105-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PURPOSE SECTION"/>
                     <text>
                        <table border="0" width="100%">
                           <tbody>
                              <tr>
                                 <td>
                                    <content styleCode="italics">
                                       <content styleCode="bold">Active ingredients</content>
                                    </content>
                                 </td>
                                 <td>
                                    <content styleCode="italics">
                                       <content styleCode="bold">Purposes</content>
                                    </content>
                                 </td>
                              </tr>
                              <tr>
                                 <td>Acetaminophen 250 mg...................</td>
                                 <td>Pain reliever</td>
                              </tr>
                              <tr>
                                 <td>Aspirin 250 mg 
     <content styleCode="bold">(NSAID*)</content>................
    </td>
                                 <td>Pain reliever</td>
                              </tr>
                              <tr>
                                 <td>Caffeine 65 mg.................................</td>
                                 <td>Pain reliever aid</td>
                              </tr>
                           </tbody>
                        </table>
                        <paragraph>* nonsteroidal anti-inflammatory drug</paragraph>
                     </text>
                     <effectiveTime value="20250812"/>
                  </section>
